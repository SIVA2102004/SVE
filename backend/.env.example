# ==================================================
# SHOPFLOW BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==================================================

# Server Port
PORT=5000

# Database URL
# For SQLite (local zero-configuration development):
DATABASE_URL="file:./shopflow.db"
# For PostgreSQL (hosted production deployment on Neon / Supabase / AWS RDS):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/shopflow?schema=public"

# Authentication Secrets (Generate strong random 64-char strings in production)
JWT_SECRET="your_production_jwt_secret_key_here_min_32_characters"
REFRESH_TOKEN_SECRET="your_production_refresh_token_secret_key_here_min_32_characters"

# Frontend Origin for CORS and WebSockets
FRONTEND_URL="http://localhost:5173"

# Node Environment ('development' | 'production')
NODE_ENV="development"

# Optional Cloud Storage (e.g. Cloudinary, AWS S3, or Supabase Storage)
# STORAGE_PROVIDER="local"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
